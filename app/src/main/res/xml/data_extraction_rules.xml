<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same, for both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="shell.xml" />
        <include domain="file" path="datastore/shell.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="shell.xml" />
        <include domain="file" path="datastore/shell.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
