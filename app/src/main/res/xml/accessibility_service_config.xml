<?xml version="1.0" encoding="utf-8"?>
<!-- No accessibilityEventTypes and canRetrieveWindowContent=false: this service receives nothing and sees nothing.
     It exists only so Shell can ask the system to lock the screen or open the notification shade. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/lock_service_description"
    android:notificationTimeout="100" />
